{
  "id": "nulldc",
  "name": "NullDC",
  "source": "playnite@e2e6efcda311",
  "detect": {
    "programs": [
      "^nullDC.*\\.exe$"
    ],
    "archive": "nulldc"
  },
  "start": {
    "args": "-config nullDC_GUI:Fullscreen=1 -config nullDC:Emulator.Autostart=1 -config ImageReader:LoadDefaultImage=1 -config ImageReader:DefaultImage=\"{rom}\""
  },
  "systems": [
    "dreamcast"
  ],
  "extraExts": [
    ".iso",
    ".bwt",
    ".b5t",
    ".b6t",
    ".ccd",
    ".cue",
    ".mds",
    ".nrg",
    ".pdi"
  ]
}
