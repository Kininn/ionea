{
  "id": "lichii",
  "name": "Lichii",
  "family": "eden",
  "tested": {
    "min": "228",
    "max": "386.*"
  },
  "detect": {
    "programs": [
      "lichii.exe"
    ],
    "archive": "lichii"
  },
  "systems": [
    "switch2"
  ],
  "requiredFiles": [
    {
      "name": "prod.keys",
      "path": "user\\keys\\prod.keys",
      "check": "switch-keys",
      "share": "switch-keys"
    },
    {
      "name": "title.keys",
      "path": "user\\keys\\title.keys",
      "check": "switch-titlekeys",
      "share": "switch-titlekeys",
      "optional": true
    },
    {
      "name": "Firmware",
      "path": "user\\nand\\system\\Contents\\registered\\",
      "check": "switch-firmware",
      "share": "switch2-firmware",
      "optional": true
    }
  ],
  "video": {
    "format": "ini",
    "style": "qt",
    "sep": "=",
    "file": "user\\config\\qt-config.ini",
    "perGame": "user\\config\\custom\\{gameid}.ini",
    "gameId": "switch",
    "noGameId": "Its title id wasn't found (add prod.keys, or a [title id] in the file name)",
    "savesOnExit": true,
    "summary": "resolution, upscaling, frame pacing",
    "settings": [
