<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logic tests with no test framework (builds offline): dotnet run -c Release in this folder. Exit code = failures. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ionea.Tests</AssemblyName>
    <RootNamespace>Ionea.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- the game sound queue works on raw sound memory -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Launcher.csproj" />
  </ItemGroup>
</Project>
